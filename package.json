{
  "name": "siamese-break",
  "version": "1.0.2",
  "description": "每工作 30 分钟，一只暹罗猫会跑出来占满屏幕卖萌 1 分钟",
  "main": "src/main.js",
  "author": "WHXisWH",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "io.github.whxiswh.siamesebreak",
    "productName": "SiameseBreak",
    "copyright": "WHXisWH",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "SiameseBreak-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "暹罗猫休息提醒",
      "artifactName": "SiameseBreak-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "SiameseBreak-Portable-${version}.${ext}"
    }
  }
}
